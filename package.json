    "check": "npm run build && npm test && npm run test:flow"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@vitejs/plugin-react": "5.0.4",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}